{
  "name": "wpreturns",
  "version": "1.0.0",
  "description": "WPReturns \u2013 Returns, RMA & EU Withdrawal Button for WooCommerce",
  "private": true,
  "scripts": {
    "test": "php bin/test-free-boundary.php",
    "build": "cross-env NODE_ENV=production webpack",
    "start": "cross-env NODE_ENV=development webpack --watch",
    "build:release": "sh ./bin/build-plugin-zip.sh",
    "postbuild": "npm run replace-textdomain && npm run i18n",
    "replace-textdomain": "node bin/replace-textdomain.js",
    "i18n": "npm run -s i18n:js && npm run -s i18n:check && npm run -s i18n:pot && npm run -s i18n:build && npm run i18n:json",
    "i18n:build": "php bin/combine-pot-files.php i18n/wpreturns.po i18n/wpreturns.pot && rm -f i18n/wpreturns.po",
    "i18n:check": "grunt checktextdomain",
    "i18n:js": "cross-env NODE_ENV=production babel src -o /dev/null",
    "i18n:json": "sh ./bin/make-i18n-json.sh",
    "i18n:pot": "grunt makepot"
  },
  "author": "devdiggers",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@wordpress/babel-plugin-makepot": "^6.0.0",
    "babel-loader": "^9.1.3",
    "cross-env": "^7.0.3",
    "css-loader": "^6.10.0",
    "css-minimizer-webpack-plugin": "^6.0.0",
    "grunt": "^1.6.1",
    "grunt-checktextdomain": "^1.0.1",
    "grunt-wp-i18n": "^1.0.3",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "mini-css-extract-plugin": "^2.8.1",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4"
  }
}
