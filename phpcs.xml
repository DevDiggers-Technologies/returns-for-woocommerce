<?xml version="1.0"?>
<ruleset name="DevDiggers Returns">
	<description>WordPress Coding Standards with the DevDiggers house style (short arrays, feature-name.php files).</description>

	<file>.</file>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/devdiggers-framework/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/bin/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="s"/>

	<config name="minimum_supported_wp_version" value="6.5"/>
	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!-- DevDiggers style: short array syntax and file names without the class- prefix (MultiPOS, LoyaltyX). -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
				<element value="edit_product"/>
				<element value="edit_products"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="devdiggers-returns"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ddwcwr"/>
				<element value="DDWCWPReturns"/>
			</property>
		</properties>
	</rule>
</ruleset>
